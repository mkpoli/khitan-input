{
  "name": "khitan-input",
  "version": "0.1.0",
  "private": true,
  "description": "Find a Khitan small-script grapheme by its reading, number, shape group or meaning, read its record, and enter it.",
  "license": "MIT",
  "author": "mkpoli",
  "homepage": "https://khitan.mkpo.li/",
  "type": "module",
  "scripts": {
    "dev": "vite app",
    "build": "vite build app",
    "preview": "vite preview app",
    "test": "bun test tests",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "verify": "bun run test && bun run check && python3 -m unittest discover tests",
    "build:db": "python3 scripts/build_db.py",
    "build:site": "python3 scripts/build_site_data.py"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/bun": "1.3.14",
    "svelte": "5.57.0",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
