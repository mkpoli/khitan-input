{
  "name": "khitan-input",
  "compatibility_date": "2026-10-30",
  // The worker writes each page's head into the app's HTML; a miss opens the app so a link can carry a query.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist/site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/syllabary", "/syllabary/",
      "/graphemes", "/graphemes/",
      "/draw", "/draw/",
      "/reading", "/reading/",
      "/words", "/words/",
      "/sentences", "/sentences/",
      "/blocks", "/blocks/",
      "/large", "/large/",
      "/jurchen", "/jurchen/",
      "/seal", "/seal/",
      "/codes", "/codes/",
      "/documents", "/documents/",
      "/about", "/about/"
    ],
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "khitan.mkpo.li", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true }
}
