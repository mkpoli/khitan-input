{
  "name": "khitan-input",
  "compatibility_date": "2026-10-30",
  // The worker serves the app for its own paths and keeps a 404 for everything else.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist/site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/syllabary", "/syllabary/",
      "/graphemes", "/graphemes/",
      "/draw", "/draw/",
      "/reading", "/reading/",
      "/words", "/words/",
      "/sentences", "/sentences/",
      "/blocks", "/blocks/",
      "/large", "/large/",
      "/jurchen", "/jurchen/",
      "/seal", "/seal/",
      "/codes", "/codes/",
      "/documents", "/documents/",
      "/about", "/about/"
    ],
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "khitan.mkpo.li", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true }
}
