# The build names every asset after its content, so a year is safe and a repeat visit fetches nothing.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The faces and the records keep their names across builds, so they are kept for a day.
/fonts/*
  Cache-Control: public, max-age=86400

/data/*
  Cache-Control: public, max-age=3600
